# Copiar a `.env` (gitignored) y rellenar. Si estas variables NO están, el
# dashboard usa el MockDataSource automáticamente (datos simulados).

# Proyecto Supabase (COLSUBSIDIO-leads). URL pública del proyecto.
VITE_SUPABASE_URL=

# Key publishable/anon (segura para el cliente, protegida por RLS).
VITE_SUPABASE_ANON_KEY=
