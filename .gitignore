# ---------------------------------------------------------------------------
# Secretos / entorno (NUNCA subir)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Frontend (Node)
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.next/
.vite/
# Cache local de frontend/tools/scrape_proyectos.py (volcado crudo de fichas
# y polígonos de localidades) — pesa varios MB y se regenera con un re-scrape,
# no debe versionarse.
frontend/tools/.cache_fichas.json
frontend/tools/.cache_localidades.json
# Artefactos de build de TypeScript
*.tsbuildinfo
# vite.config.ts emitido por tsc -b (composite)
dashboard/vite.config.js
dashboard/vite.config.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Backend (Python)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Clustering / modelos
# ---------------------------------------------------------------------------
# Los modelos pesados NO van en git directo. Si hay que versionarlos, usar git-lfs:
#   git lfs install && git lfs track "*.pkl"
*.pkl
.ipynb_checkpoints/
# Salida generada por el modelo de recomendaciones (no versionar)
modelo_recomendaciones/recomendaciones.json

# ---------------------------------------------------------------------------
# Sistema operativo / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# Volcado de estilos computados de la pagina real de Colsubsidio
# (frontend/tools/clonar_portada.py --medir). Es insumo para escribir el CSS
# a mano, no lo consume la app.
frontend/tools/.estilos_portada.json
